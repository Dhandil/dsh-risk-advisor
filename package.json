{
  "name": "@dhandil/dsh-risk-advisor",
  "version": "0.1.0-r1",
  "description": "Disposable Risk Advisor approval-detail test fixture for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/r1-fixture.unit.spec.tsx",
    "test:integration": "vitest run tests/r1-slot.integration.spec.tsx",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-approval": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.6-alpha.2",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ]
}
