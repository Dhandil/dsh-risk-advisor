{
  "name": "@dhandil/dsh-risk-advisor",
  "version": "0.1.0-r1",
  "description": "Disposable Risk Advisor approval-detail test fixture for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "pnpm run test:r1 && pnpm run test:r2 && pnpm run test:r3 && pnpm run test:r4 && pnpm run test:r5 && pnpm run test:p1a",
    "test:r1": "vitest run tests/r1-fixture.unit.spec.tsx tests/r1-slot.integration.spec.tsx",
    "test:r2": "vitest run tests/r2-correlation.unit.spec.ts tests/r2-runtime.integration.spec.ts",
    "test:r3": "vitest run tests/r3-ptc-replay.unit.spec.ts tests/r3-runtime.integration.spec.ts",
    "test:unit": "vitest run tests/r1-fixture.unit.spec.tsx",
    "test:integration": "vitest run tests/r1-slot.integration.spec.tsx",
    "test:r2:unit": "vitest run tests/r2-correlation.unit.spec.ts",
    "test:r2:integration": "vitest run tests/r2-runtime.integration.spec.ts",
    "test:r3:unit": "vitest run tests/r3-ptc-replay.unit.spec.ts",
    "test:r3:integration": "vitest run tests/r3-runtime.integration.spec.ts",
    "test:r4": "vitest run tests/r4-ledger.unit.spec.ts tests/r4-runtime.integration.spec.ts",
    "test:r4:unit": "vitest run tests/r4-ledger.unit.spec.ts",
    "test:r4:integration": "vitest run tests/r4-runtime.integration.spec.ts",
    "test:r5": "vitest run tests/r5-benchmark.unit.spec.ts",
    "test:p1a": "vitest run tests/p1a-operation-foundation.unit.spec.ts tests/p1a-runtime.integration.spec.ts",
    "bench:r5:smoke": "pnpm run build && vitest run --config vitest.config.ts tests/r5-benchmark-smoke.spec.ts",
    "bench:r5": "pnpm run build && vitest run --config vitest.config.ts tests/r5-benchmark-full.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-session": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-user-approval": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-approval": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.1.6-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.6-alpha.2",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "use-sync-external-store": "^1.2.0",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ]
}
